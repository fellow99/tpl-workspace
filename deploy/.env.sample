# ============================================================
# tpl-workspace Docker Compose 环境变量
# 由 docker compose 自动加载（与 docker-compose.yml 同目录）
# 生产环境务必修改默认密码与 API Key
# ============================================================

# ---- PostgreSQL 数据库 ----
POSTGRES_DB=tpl_manage
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---- Redis 缓存 ----
REDIS_PASSWORD=postgres

# ---- 微信登录（默认启用；填入开放平台/公众平台 AppID/Secret 后各端登录才可用）----
WECHAT_LOGIN_ENABLED=true
# 网站应用（tpl-app-web 扫码登录，scope=snsapi_login）
WECHAT_WEB_APPID=
WECHAT_WEB_SECRET=
WECHAT_WEB_REDIRECT_URI=
# 移动应用（tpl-app-android / tpl-app-harmony 拉起登录，scope=snsapi_userinfo）
WECHAT_APP_APPID=
WECHAT_APP_SECRET=
# 小程序（tpl-app-mini 一键登录，wx.login → jscode2session）
WECHAT_XCX_APPID=wx6f403bf72762b0c3
WECHAT_XCX_SECRET=

# ---- 密钥（样例占位值，生产必须轮换）----
SA_TOKEN_JWT_SECRET=changeMe
MINIO_SECRET_KEY=minioadmin
RSA_PRIVATE_KEY=changeMe

# ---- 连接配置（docker 服务名）----
DB_URL=jdbc:postgresql://postgres:5432/tpl_manage
DB_URL_MANAGE=jdbc:postgresql://postgres:5432/tpl_manage?useUnicode=true&characterEncoding=utf8&useSSL=false&autoReconnect=true&reWriteBatchedInserts=true
DB_USERNAME=postgres
REDIS_HOST=redis
REDIS_PORT=6379
SMS_BASE_URL=https://push.spug.cc
SMS_TEMPLATE_CODE=changeMe
