# ============================================================
# tpl-app-web 前端 Dockerfile — 多阶段构建
# 阶段1: pnpm 编译 (node:24-alpine)
# 阶段2: Nginx SPA 静态文件服务
# ============================================================

# ---- Stage 1: pnpm Build ----
FROM node:24-alpine AS builder

# 启用 pnpm
RUN corepack enable && corepack prepare pnpm@10.34.5 --activate

WORKDIR /workspace

# 先复制 package.json 和 lockfile，利用 Docker 层缓存
COPY tpl-app-web/package.json tpl-app-web/pnpm-lock.yaml* tpl-app-web/

# 安装依赖 (使用国内镜像加速)
RUN cd tpl-app-web && pnpm install --frozen-lockfile --registry=https://registry.npmmirror.com 2>/dev/null || \
    cd tpl-app-web && pnpm install --registry=https://registry.npmmirror.com

# 复制前端全部源代码
COPY tpl-app-web/ tpl-app-web/

# 构建生产包
WORKDIR /workspace/tpl-app-web
RUN pnpm run build

# ---- Stage 2: Nginx 静态文件服务 ----
FROM nginx:latest

# 时区
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# 从构建阶段复制 dist 产物
COPY --from=builder /workspace/tpl-app-web/dist /usr/share/nginx/html

# 复制 nginx SPA 配置
COPY deploy/nginx/tpl-app-web.conf /etc/nginx/conf.d/default.conf

# 健康检查
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=10s \
    CMD curl -f http://localhost:80/ || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
