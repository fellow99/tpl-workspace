# ============================================================
# tpl-manage 后端 Dockerfile — 多阶段构建
# 阶段1: Maven 编译 (maven:3.9-eclipse-temurin-21)
# 阶段2: JRE 运行 (eclipse-temurin:21-jdk)
# ============================================================

# ---- Stage 1: Maven 编译 ----
FROM maven:3.9-eclipse-temurin-21 AS builder

WORKDIR /workspace

# 先复制 POM 文件，利用 Docker 层缓存加速依赖下载
COPY tpl-manage/pom.xml                    tpl-manage/
COPY tpl-manage/tpl-manage-admin/pom.xml    tpl-manage/tpl-manage-admin/

# 复制 RuoYi-Vue-Plus 全部源码 (含所有子模块)
COPY RuoYi-Vue-Plus/ RuoYi-Vue-Plus/

# 预下载全部 Maven 依赖 — 缓存层
RUN mvn -f RuoYi-Vue-Plus/pom.xml dependency:go-offline -DskipTests 2>/dev/null; exit 0

# 复制 tpl-manage 全部源代码
COPY tpl-manage/ tpl-manage/

# Step 1: 安装 RuoYi-Vue-Plus 到本地 Maven 仓库 (解决 parent POM 引用)
RUN mvn -f RuoYi-Vue-Plus/pom.xml clean install -DskipTests

# Step 2: 构建 tpl-manage-admin (parent 从本地 .m2 仓库解析)
WORKDIR /workspace/tpl-manage
RUN mvn clean install -pl tpl-manage-admin -am -DskipTests

# ---- Stage 2: JRE 运行 ----
FROM eclipse-temurin:21-jdk

ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

WORKDIR /app

COPY --from=builder /workspace/tpl-manage/tpl-manage-admin/target/tpl-manage-admin.jar app.jar
RUN mkdir -p /app/logs

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=90s \
    CMD curl -f http://localhost:8081/ || exit 1

EXPOSE 8081

ENTRYPOINT ["sh", "-c", "java \
    -XX:+UseZGC \
    -Xss512k \
    -XX:MaxRAMPercentage=75.0 \
    -Djava.security.egd=file:/dev/./urandom \
    -Dspring.profiles.active=docker \
    -jar app.jar"]
