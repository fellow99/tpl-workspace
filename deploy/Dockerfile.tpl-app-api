# ============================================================
# tpl-app-api 后端 Dockerfile — 多阶段构建
# 阶段1: Maven 编译 (maven:3.9-eclipse-temurin-17)
# 阶段2: JRE 运行 (eclipse-temurin:17-jre)
# ============================================================

# ---- Stage 1: Maven 编译 ----
FROM maven:3.9-eclipse-temurin-21 AS builder

WORKDIR /workspace

# 先复制 POM 文件，利用 Docker 层缓存加速依赖下载
COPY tpl-app-api/pom.xml tpl-app-api/

# 预下载 Maven 依赖 — 缓存层
RUN mvn -f tpl-app-api/pom.xml dependency:go-offline -DskipTests 2>/dev/null; exit 0

# 复制 tpl-app-api 全部源代码
COPY tpl-app-api/ tpl-app-api/

# 构建 Spring Boot fat jar
WORKDIR /workspace/tpl-app-api
RUN mvn clean package -DskipTests

# ---- Stage 2: JRE 运行 ----
FROM eclipse-temurin:21-jdk

ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

WORKDIR /app

COPY --from=builder /workspace/tpl-app-api/target/tpl-app-api-1.0.0-SNAPSHOT.jar app.jar
RUN mkdir -p /app/logs

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=60s \
    CMD curl -f http://localhost:8082/actuator/health || exit 1

EXPOSE 8082

ENTRYPOINT ["sh", "-c", "java \
    -Xss512k \
    -XX:MaxRAMPercentage=75.0 \
    -Djava.security.egd=file:/dev/./urandom \
    -Dspring.profiles.active=docker \
    -jar app.jar"]
